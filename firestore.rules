rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApprovedAdmin() {
      return isSignedIn() && myProfile().status == 'approved' && myProfile().role == 'admin';
    }
    function isApprovedUser() {
      return isSignedIn() && myProfile().status == 'approved';
    }

    // Every signed-in user has exactly one profile doc, keyed by their own uid.
    match /users/{userId} {
      // Anyone can create their OWN profile at signup, but only as a pending, non-admin user.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'user';

      // You can read your own profile (to check approval status). Admins can read everyone's.
      allow read: if isSignedIn() && (request.auth.uid == userId || isApprovedAdmin());

      // Only an approved admin can approve/reject/edit a profile.
      allow update, delete: if isApprovedAdmin();
    }

    // Public username -> email lookup, so people can log in by typing just a username.
    // Only a `get` on one exact, known document ID is allowed — never a `list` — so this
    // can't be used to browse or enumerate every account, only to resolve a username you
    // already know into the email needed for signInWithEmailAndPassword.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['email'])
                    && request.resource.data.email is string;
      allow update, delete: if false;
    }

    // The actual registry data. Only approved users (or admins) can read/write it.
    match /entries/{entryId} {
      allow read, write: if isApprovedUser();
    }

    // Password reset requests. Created from the login screen, before anyone is signed in,
    // so creation must be open — but restricted to the exact shape a legitimate request has.
    // Only an admin can see the list or mark one as sent.
    match /password_reset_requests/{requestId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.username is string
                    && request.resource.data.username.size() > 0
                    && request.resource.data.username.size() < 60;
      allow read, update, delete: if isApprovedAdmin();
    }
  }
}
